# Set these in Vercel's environment settings or local .env.local.
# Generate a random signing key of at least 32 bytes.
JWT_SECRET_KEY=
# Use Supabase's session-pooler connection string for the Node.js pg driver.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=crm-contracts
# CLI setup only (use environment variables, never commit real values).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
# Local development uses the existing crm.db by default.
# SQLITE_PATH=crm.db
