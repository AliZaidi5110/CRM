{
  "name": "callpro-crm",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --import tsx --test tests-node/*.test.ts",
    "db:init": "node --env-file-if-exists=.env.local --import tsx scripts/init-db.ts",
